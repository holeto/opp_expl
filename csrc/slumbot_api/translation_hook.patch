+// The uniform draw that picks between the two abstract sizes bracketing an opponent bet (the
+// below size iff r < below_prob). Virtual so that a caller can supply the draw itself; this
+// default reproduces the original per-translation seeding exactly.
+double StatelessNLAgent::TranslationDraw(int hand_index, bool p1_choice, size_t path_size,
+                                         double below_prob)
+{
+  int seed = hand_index * 967 + (p1_choice ? 23 : 0) + path_size * 7;
+  SeedRand(seed);
+  return RandZeroToOne();
+}
